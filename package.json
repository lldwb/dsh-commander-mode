{
  "name": "dsh-commander-mode",
  "version": "8.2.4",
  "description": "一个 DSH 模式 + 一个可选工作流组件：三层指挥链（指挥官 → 小组长 → 子智能体），指挥官接单、按任务形状拆分、派给小组长（自己执行或再交子智能体）并逐项验收，自己不执行操作。含执行边界与禁止等待的硬门禁、派发通道与任务板/工单写入门禁、看板告警、停滞与退化看门狗、通知补投与冷唤醒、工单与计划授权、共享任务板投影、外部事件接入与运维巡检；六位开发流程专家（架构 / 实现 / 审查 / 测试 / 安全 / 文档）与六段工作流均按需使用。Team 成员按可续做的标准 subagent 工作，使用本模式时智能体团队默认开启且不可关闭。",
  "type": "module",
  "license": "MIT",
  "private": true,
  "icon": "./icon.svg",
  "main": "./index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lldwb/dsh-commander-mode.git"
  },
  "homepage": "https://github.com/lldwb/dsh-commander-mode#readme",
  "bugs": {
    "url": "https://github.com/lldwb/dsh-commander-mode/issues"
  },
  "exports": {
    ".": "./index.js",
    "./agent": "./agent.js",
    "./preset-commander": "./preset-commander.js",
    "./preset-commander/icon": "./preset-commander/icon.svg",
    "./preset-commander/locale/*.json": "./preset-commander/locale/*.json",
    "./preset-cc": "./preset-cc.js",
    "./preset-cc/icon": "./preset-cc/icon.svg",
    "./preset-cc/locale/*.json": "./preset-cc/locale/*.json",
    "./workflow": "./workflow.js",
    "./client": "./client.js",
    "./specialist": "./specialist.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "agent.js",
    "workflow.js",
    "client.js",
    "specialist.js",
    "lib/*.js",
    "skills/**",
    "bin/*.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "test/*.mjs",
    "preset-commander.js",
    "preset-commander/**",
    "preset-cc.js",
    "preset-cc/**"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "status": "node bin/commander-status.mjs",
    "event": "node bin/commander-event.mjs"
  },
  "bin": {
    "commander-status": "./bin/commander-status.mjs",
    "commander-event": "./bin/commander-event.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "bundle",
    "agent-preset",
    "agent-mode",
    "orchestrator",
    "commander",
    "agent-teams",
    "delegation",
    "hierarchy",
    "team-lead",
    "multi-model",
    "specialist"
  ],
  "meta": {
    "title": "指挥者模式",
    "description": "一个 DSH 模式 + 一个可选工作流组件：三层指挥链（指挥官 → 小组长 → 子智能体），指挥官接单、按任务形状拆分、派给小组长（自己执行或再交子智能体）并逐项验收，自己不执行操作。含执行边界与禁止等待的硬门禁、派发通道与任务板/工单写入门禁、看板告警、停滞与退化看门狗、通知补投与冷唤醒、工单与计划授权、共享任务板投影、外部事件接入与运维巡检；六位开发流程专家（架构 / 实现 / 审查 / 测试 / 安全 / 文档）与六段工作流均按需使用。Team 成员按可续做的标准 subagent 工作，使用本模式时智能体团队默认开启且不可关闭。",
    "note": "DSH 的插件卡片标题/描述只读 package.json 的 name/description 与 locale/*.json 的 {\"meta\":{...}}，不读这里的字段；保留它只是给人看的。"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  }
}
