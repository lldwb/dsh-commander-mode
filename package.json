{
  "name": "dsh-commander-mode",
  "version": "0.3.5",
  "description": "你只做判断，子代理做执行：接单、拆解、派活、验收，规划与分歧交回你确认。开箱带六位开发流程专家（架构 / 实现 / 审查 / 测试 / 安全 / 文档），可在设置页增删并绑定各自模型。",
  "type": "module",
  "license": "MIT",
  "private": true,
  "icon": "./icon.svg",
  "main": "./index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lldwb/dsh-commander-mode.git"
  },
  "homepage": "https://github.com/lldwb/dsh-commander-mode#readme",
  "bugs": {
    "url": "https://github.com/lldwb/dsh-commander-mode/issues"
  },
  "exports": {
    ".": "./index.js",
    "./agent": "./agent.js",
    "./client": "./client.js",
    "./specialist": "./specialist.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "agent.js",
    "client.js",
    "specialist.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "test/*.mjs"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "bundle",
    "agent-preset",
    "agent-mode",
    "orchestrator",
    "commander",
    "agent-teams",
    "delegation",
    "multi-model",
    "specialist"
  ],
  "meta": {
    "title": "指挥者模式",
    "description": "你只做判断，子代理做执行：接单、拆解、派活、验收，规划与分歧交回你确认。开箱带六位开发流程专家（架构 / 实现 / 审查 / 测试 / 安全 / 文档），可在设置页增删并绑定各自模型。",
    "note": "DSH 的插件卡片标题/描述只读 package.json 的 name/description 与 locale/*.json 的 {\"meta\":{...}}，不读这里的字段；保留它只是给人看的。"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  }
}
