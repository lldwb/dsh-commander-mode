{
  "name": "dsh-commander-mode",
  "version": "2.2.0",
  "description": "两个 DSH 模式 + 一个开发工作流组件：指挥者模式接单拆解派活验收；项目经理模式用六位开发流程专家（架构 / 实现 / 审查 / 测试 / 安全 / 文档）跑六段带门禁的流水线，每段 git 分类提交、收尾写经验教训。另含 wait_agent 长等待门禁。（项目经理模式继承自「指挥者模式」+「Agent 预设定义」）",
  "type": "module",
  "license": "MIT",
  "private": true,
  "icon": "./icon.svg",
  "main": "./index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lldwb/dsh-commander-mode.git"
  },
  "homepage": "https://github.com/lldwb/dsh-commander-mode#readme",
  "bugs": {
    "url": "https://github.com/lldwb/dsh-commander-mode/issues"
  },
  "exports": {
    ".": "./index.js",
    "./agent": "./agent.js",
    "./preset-commander": "./preset-commander.js",
    "./preset-commander/icon": "./preset-commander/icon.svg",
    "./preset-commander/locale/*.json": "./preset-commander/locale/*.json",
    "./preset-project-manager": "./preset-project-manager.js",
    "./preset-project-manager/icon": "./preset-project-manager/icon.svg",
    "./preset-project-manager/locale/*.json": "./preset-project-manager/locale/*.json",
    "./project-manager": "./project-manager.js",
    "./workflow": "./workflow.js",
    "./client": "./client.js",
    "./specialist": "./specialist.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "agent.js",
    "project-manager.js",
    "workflow.js",
    "client.js",
    "specialist.js",
    "lib/*.js",
    "skills/**",
    "bin/*.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "test/*.mjs",
    "preset-commander.js",
    "preset-project-manager.js",
    "preset-commander/**",
    "preset-project-manager/**"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "status": "node bin/commander-status.mjs",
    "event": "node bin/commander-event.mjs"
  },
  "bin": {
    "commander-status": "./bin/commander-status.mjs",
    "commander-event": "./bin/commander-event.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "bundle",
    "agent-preset",
    "agent-mode",
    "orchestrator",
    "commander",
    "agent-teams",
    "delegation",
    "multi-model",
    "specialist"
  ],
  "meta": {
    "title": "指挥者模式 · 项目经理模式",
    "description": "两个 DSH 模式 + 一个开发工作流组件：指挥者模式接单拆解派活验收；项目经理模式用六位开发流程专家（架构 / 实现 / 审查 / 测试 / 安全 / 文档）跑六段带门禁的流水线，每段 git 分类提交、收尾写经验教训。另含 wait_agent 长等待门禁。（项目经理模式继承自「指挥者模式」+「Agent 预设定义」）",
    "note": "DSH 的插件卡片标题/描述只读 package.json 的 name/description 与 locale/*.json 的 {\"meta\":{...}}，不读这里的字段；保留它只是给人看的。"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  }
}
